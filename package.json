{
  "name": "image-insight",
  "version": "1.3.8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "dev": "npm run build",
    "verify": "npm run typecheck && npm run build && npm test && node --check main.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "esbuild": "0.25.12",
    "eslint": "^10.0.1",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
